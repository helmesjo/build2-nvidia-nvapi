intf_libs = # Interface dependencies.
#import xxxx_libs += libhello%lib{hello}

lib{nvapi}: h{**} $intf_libs

# Build options.
#
out_pfx = [dir_path] $out_root/include/
src_pfx = [dir_path] $src_root/include/

c.poptions =+ "-I$out_pfx" "-I$src_pfx"

# Export options.
#
lib{nvapi}:
{
  c.export.poptions = "-I$out_pfx" "-I$src_pfx"
  c.export.libs = $intf_libs
}

# Upstream's own switch for compilers without Microsoft SAL: it keeps the
# fallback SAL macros defined across all of the headers.
#
if ($c.target.system == 'mingw32')
  lib{nvapi}: c.export.poptions += -D__NVAPI_EMPTY_SAL

# Install recreating subdirectories.
#
h{*}:
{
  install         = include/
  install.subdirs = true
}
